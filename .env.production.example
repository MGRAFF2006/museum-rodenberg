# Copy to .env.production (ignored). Never put credentials in VITE_* variables.
PUBLIC_ORIGIN=https://museum.humunkulud.com
MUSEUM_PORT=3003
CONVEX_PORT=3213
ADMIN_PASSWORD=
# Generate on the new backend and save here; do not reuse the old deployment key.
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Generated by cloudflared tunnel create; keep the JSON credential out of Git.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=./.cloudflare-tunnel-credentials.json
# LibreTranslate is optional: start with --profile translate when curators need it.
LIBRETRANSLATE_API_URL=http://libretranslate:5000/translate
LIBRETRANSLATE_API_KEY=
